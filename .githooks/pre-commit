#!/usr/bin/env sh

# Generate translations.json if language files are staged
STAGED_LANG_FILES=$(git diff --cached --name-only --diff-filter=ACDMR | grep -E '(languages/.*\.(mo|po)|^[a-z]{2}/welcome-post\.html)$')

if [ -n "$STAGED_LANG_FILES" ]; then
	echo "Regenerating translations.json..."
	node bin/generate-translations-json.mjs
	git add translations.json
fi

# Format staged files with prettier
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(css|html|json|js|php)$')

if [ -n "$STAGED_FILES" ]; then
	echo "Formatting staged files..."
	echo "$STAGED_FILES" | xargs npx prettier --write
	echo "$STAGED_FILES" | xargs git add
fi

exit 0
